{
  "name": "opensrc_wa",
  "version": "0.4.0",
  "private": true,
  "description": "Multi-provider unofficial WhatsApp gateway with deterministic mock runtime, isolated Baileys live adapter, queued delivery, durable auth, and streaming media storage.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "lint": "node scripts/lint.mjs",
    "format:check": "node scripts/format-check.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "test:unit": "node scripts/test.mjs unit",
    "test:integration": "node scripts/test.mjs integration",
    "test:live": "node scripts/live-e2e.mjs",
    "start": "node dist/apps/gateway/src/index.js",
    "start:live": "node dist/apps/live-gateway/src/index.js",
    "dev": "node --experimental-strip-types apps/gateway/src/index.ts",
    "dev:live": "node --experimental-strip-types apps/live-gateway/src/index.ts",
    "cli": "node dist/apps/cli/src/index.js",
    "docs:check": "node scripts/docs-check.mjs",
    "dependency:check": "node scripts/dependency-check.mjs",
    "validate": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run docs:check && npm run dependency:check && npm run license:check",
    "license:check": "node scripts/license-check.mjs"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "qrcode": "1.5.4"
  }
}
