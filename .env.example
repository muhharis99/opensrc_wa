NODE_ENV=development
HOST=0.0.0.0
PORT=3000
OPEN_SRC_WA_API_KEY_SHA256=replace_with_sha256_hex
OPEN_SRC_WA_SESSION_KEY=replace_with_64_hex_characters
OPEN_SRC_WA_STORE=encrypted-file
OPEN_SRC_WA_DATA_DIR=./runtime
OPEN_SRC_WA_PROTOCOL_MODE=mock
OPEN_SRC_WA_CORS_ORIGINS=http://localhost:3000
OPEN_SRC_WA_RATE_LIMIT_PER_MINUTE=120
OPEN_SRC_WA_MAX_BODY_BYTES=262144
OPEN_SRC_WA_WEBHOOK_TIMEOUT_MS=5000
OPEN_SRC_WA_WEBHOOK_MAX_RETRIES=4
ENABLE_LIVE_E2E=false
